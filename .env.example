# Database (ParadeDB PostgreSQL on port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5433/dochat

# Redis (Cache, Rate Limiting & Celery Broker)
REDIS_URL=redis://localhost:6379/0

# Embeddings (1024-dim via Voyage AI)
VOYGERAI_API_KEY=

# LLM Providers
GROQ_API_KEY=
GEMINI_API_KEY=

# JWT Authentication
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Resend Email (Optional)
RESEND_API_KEY=onboarding@resend.dev